@model List<S6_ASPSEC_04.Models.UserViewModel>

@{
    ViewData["Title"] = "Gebruikersbeheer";
}

<h1>Gebruikersbeheer</h1>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Rollen</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.Roles</td>
                <td>
                    <form asp-action="ChangeUserRole" method="post">
                        <input type="hidden" name="userId" value="@user.Id" />

                        <select name="roleName" class="form-select">
                            @foreach (var role in user.AllRoles) // Dynamisch door de rollen itereren
                            {
                                <option value="@role" selected="@(role == user.SelectedRole ? "selected" : null)">
                                    @role
                                </option>
                            }
                        </select>

                        <button type="submit" class="btn btn-sm btn-primary mt-1">Wijzig rol</button>
                    </form>

                    <a href="@Url.Action("DeleteUser", "Admin", new { userId = user.Id })" class="btn btn-sm btn-danger mt-2">Verwijder</a>
                </td>

            </tr>
        }
    </tbody>
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
